<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Embeds icon for Windows Explorer (Disk icon)[cite: 11] -->
    <ApplicationIcon>SVC_Appicon.ico</ApplicationIcon>

    <!-- Portable Single-File Settings[cite: 1] -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained> 
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- EMBED the icon as a resource so the code can access it from memory[cite: 1, 11] -->
    <EmbeddedResource Include="SVC_Appicon.ico" />
    
    <!-- REMOVE any lines that use "CopyToOutputDirectory" for the icon[cite: 1] -->
  </ItemGroup>
</Project>