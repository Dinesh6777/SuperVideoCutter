#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

IDI_APP_ICON ICON "SVC_Appicon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SuperVideoCutter Project Team"
            VALUE "FileDescription", "SuperVideoCutter Native Media Trimmer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SuperVideoCutter.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 SuperVideoCutter. All rights reserved."
            VALUE "OriginalFilename", "SuperVideoCutter.exe"
            VALUE "ProductName", "SuperVideoCutter"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
